# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本保持 CRLF，否则 cmd.exe 解析可能异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.jar  binary
*.woff binary
*.woff2 binary
*.ttf  binary
